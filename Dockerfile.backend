FROM python:3.11-slim AS base
WORKDIR /app
RUN apt-get update && apt-get install -y gcc libpq-dev && rm -rf /var/lib/apt/lists/*
COPY requirements-fastapi.txt .
RUN pip install --no-cache-dir -r requirements-fastapi.txt
# Chromium para miniaturas de HTML renderizadas con estilos (Playwright headless).
RUN playwright install --with-deps chromium

FROM base AS dev
# En bind-mounts de Windows, watchfiles puede terminar el proceso con os error 5.
# El frontend mantiene HMR; el backend se reinicia explícitamente cuando cambia código.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]

FROM base AS prod
COPY . .
# Mientras ingesta/Issue/vault conserven estado y locks en memoria, debe haber un worker.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
