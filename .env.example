LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434/v1/chat/completions
# Cualquier API compatible con OpenAI que pida clave. Ej.: Z.ai, gratis con GLM-4.7-Flash
# (la clave se saca en z.ai). Los documentos salen de tu PC hacia ese proveedor.
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.z.ai/api/paas/v4
# LLM_MODEL=glm-4.7-flash
# LLM_API_KEY=
POSTGRES_DB=pragmaforge
POSTGRES_USER=pragma
POSTGRES_PASSWORD=pragma
DATABASE_URL=postgresql+asyncpg://pragma:pragma@db:5432/pragmaforge
DATABASE_URL_SYNC=postgresql+psycopg2://pragma:pragma@db:5432/pragmaforge
VITE_BLOOM_ENABLED=true
ALGEDI_VAULT=1
ALGEDI_ADMIN_PASSWORD=
ALGEDI_MAX_UPLOAD_MB=50
ALGEDI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Bases Postgres que el Workbench puede consultar, en sólo lectura (una por variable).
# Usá un usuario que sólo tenga permiso de lectura. Después: docker compose up -d backend
# ALGEDI_PG_VENTAS=postgresql://lector:clave@mi-servidor:5432/ventas
# Modelo de embeddings (default: intfloat/multilingual-e5-small, 512 tokens).
# Si lo cambiás: docker exec -w /app llm-wiki-local-backend-1 python reindexado.py
# ALGEDI_EMBED_MODEL=intfloat/multilingual-e5-small
# Páginas web armadas con JavaScript: si el HTML estático trae menos de N caracteres,
# Chromium (Playwright, ya instalado en la imagen) las renderiza antes de extraer.
# Default 0: no lanza el browser. Para activarlo en Docker:
#   ALGEDI_HTML_JS=1
#   docker compose up -d backend
# Rebuild de la imagen SOLO si la tuya es anterior a `playwright install chromium`
# (Dockerfile.backend). No hay paquetes pip nuevos. Ver docs/INGESTA_WEB.md.
# ALGEDI_HTML_JS=0
# ALGEDI_HTML_JS_MIN_CHARS=400
# ALGEDI_HTML_JS_TIMEOUT_MS=15000
